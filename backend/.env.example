PORT=1005

# ============ DATABASE ============
# 'sqlite' hoặc 'mysql'
DB_TYPE=sqlite

# Nếu DB_TYPE=mysql, điền thông tin dưới đây:
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=music_db
DB_PORT=3306

# ============ JWT ============
# QUAN TRỌNG: Thay bằng chuỗi ngẫu nhiên dài >= 32 ký tự khi deploy!
# Tạo tại: https://generate-secret.vercel.app/64
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET_AT_LEAST_32_CHARS

# ============ ADMIN & DEMO ACCOUNT ============
# Thay đổi những giá trị này trước khi deploy production!
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD
DEMO_EMAIL=demo@yourdomain.com
DEMO_PASSWORD=REPLACE_WITH_DEMO_PASSWORD

# ============ GOOGLE OAUTH ============
# Tạo tại: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ============ FACEBOOK OAUTH ============
# Tạo tại: https://developers.facebook.com/
FACEBOOK_APP_ID=your_facebook_app_id_here
FACEBOOK_APP_SECRET=your_facebook_app_secret_here

# ============ APP URLs ============
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:1005

# ============ CLOUDINARY ============
# Tạo tại: https://cloudinary.com/
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
